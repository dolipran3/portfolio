# Configuration du serveur chatbot
#
# Copie ce fichier en `server/.env` et mets ta vraie clé API.
# `server/.env` est ignoré par git : la clé ne doit jamais être commitée.

OPENAI_API_KEY=

# Modèle utilisé par le serveur pour générer les réponses
OPENAI_MODEL=gpt-4.1

# Modèle utilisé pour les embeddings du RAG
OPENAI_EMBEDDING_MODEL=text-embedding-3-small

# Recherche RAG
RAG_TOP_K=4
RAG_MIN_SCORE=0.3

# Garde-fous coûts
MAX_TOKENS=600
RATE_LIMIT_MAX=30
RATE_LIMIT_WINDOW_MS=60000

# Interrupteur du chatbot : true = activé, false = coupé (les messages
# reçoivent une réponse d'indisponibilité, sans appel à l'API)
CHATBOT_ENABLED=true

# Port d'écoute du serveur API
PORT=8787
